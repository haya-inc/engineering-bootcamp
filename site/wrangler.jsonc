{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "engineering-bootcamp",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "bootcamp.haya-inc.co.jp",
      "custom_domain": true,
    },
  ],
}
